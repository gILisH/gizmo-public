# Copy to deploy/backup.env (gitignored, chmod 600) and fill in. Keep a copy of
# RESTIC_PASSWORD OFF the box (password manager): without it the backups are useless.
#
# Use restic's S3-compatible backend against Backblaze B2's S3 endpoint.
# (restic's NATIVE b2: backend uses B2's deprecated v1 auth API and now fails with
#  "not currently supported on API version number 1" — use S3 instead.)
#
# Setup: create a PRIVATE bucket + a RESTRICTED app key scoped to it (not the master
# key). The key needs: listBuckets, listFiles, readFiles, writeFiles, deleteFiles.
# The S3 endpoint host must match the bucket's region (shown in the B2 console / on
# `b2 account authorize`, e.g. s3.eu-central-003.backblazeb2.com).
export RESTIC_REPOSITORY="s3:https://s3.<region>.backblazeb2.com/<bucket>/gizmo"
export RESTIC_PASSWORD="a-strong-passphrase-you-keep-safe"   # loses ALL data if lost!
export AWS_ACCESS_KEY_ID="your-b2-restricted-keyID"
export AWS_SECRET_ACCESS_KEY="your-b2-restricted-applicationKey"
# First time only:  restic init

# Optional but recommended: a Healthchecks.io check (period 1 day, grace ~2 h) for the
# backup itself — separate from the app's GIZMO_HEALTHCHECK_URL. It's pinged /start,
# success, or /fail, and alerts if a night is skipped entirely.
export GIZMO_BACKUP_HEALTHCHECK_URL="https://hc-ping.com/<uuid>"
