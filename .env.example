# Dedicated (burner) WhatsApp number — E.164 digits only, no '+'
GIZMO_DEDICATED_NUMBER=972500000000

# Personal number (read-only sensor) — optional; set to ingest your real history
# GIZMO_PERSONAL_NUMBER=972501234567

# Owners (full corpus + Google) and allowlisted family (brain response) — CSV of
# bare phone digits. Only allowlisted senders get a brain reply.
GIZMO_OWNERS=972500000000
# GIZMO_ALLOWLIST=972501111111,972502222222

# Hosted brain (leave ANTHROPIC_API_KEY unset to fall back to echo)
# ANTHROPIC_API_KEY=sk-ant-...
GIZMO_BRAIN_MODEL=claude-sonnet-4-6
# Extra brains — set the key to enable, flip live via the switch_model tool.
# GOOGLE_GENERATIVE_AI_API_KEY=...   # gemini (GIZMO_GEMINI_MODEL, default gemini-3.5-flash)
# XAI_API_KEY=xai-...                # grok  (GIZMO_GROK_MODEL, default grok-4.5) — NOT the GROQ_API_KEY below

# Creds + storage
GIZMO_CREDS_DIR=/data/creds/dedicated
GIZMO_PERSONAL_CREDS_DIR=/data/creds/personal
GIZMO_DB_PATH=/data/gizmo.db

# Local models (Ollama)
GIZMO_OLLAMA_URL=http://localhost:11434
GIZMO_EMBED_MODEL=bge-m3

GIZMO_LOG_LEVEL=warn

# Google (owner-only) — from a Desktop OAuth client in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GIZMO_GOOGLE_OWNER=972500000000

# Voice-note transcription (Groq Whisper) — https://console.groq.com
GROQ_API_KEY=
GIZMO_STT_MODEL=whisper-large-v3

# Voice-out (ElevenLabs TTS) — https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Reaction GIFs (Giphy — free key at developers.giphy.com)
GIPHY_API_KEY=
